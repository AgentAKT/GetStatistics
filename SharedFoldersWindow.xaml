<Window x:Class="GetStatistics.SharedFoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Управление сетевыми ресурсами" 
        Height="600" 
        Width="900"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource {x:Type Window}}"
        Background="{StaticResource LightBackground}">

    <Window.Resources>
        <Style TargetType="Label" BasedOn="{StaticResource ModernLabel}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
        <Style TargetType="ListView" BasedOn="{StaticResource ModernListView}"/>
        <Style TargetType="TreeView" BasedOn="{StaticResource ModernTreeView}"/>
        <Style TargetType="ContextMenu" BasedOn="{StaticResource ModernContextMenu}"/>
        <Style TargetType="MenuItem" BasedOn="{StaticResource ModernMenuItem}"/>

        <Style x:Key="SectionHeader" TargetType="Label">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="ModernProgressBar" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Background" Value="{StaticResource LightBackground}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="6"/>
            <Setter Property="IsIndeterminate" Value="True"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFD3D3D3"/>
                                <!-- Светло-серый -->
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FF0078D7"/>
                                <!-- Синий (стандартный для выделения) -->
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="OverlayGrid" Panel.ZIndex="1000" 
              Visibility="Collapsed" Background="#80000000">
            <Border Background="{StaticResource LightBackground}" 
                    CornerRadius="5" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                    <ProgressBar Style="{StaticResource ModernProgressBar}" Width="200" Margin="0,0,0,10"/>
                    <TextBlock x:Name="LoadingText" Text="Подключение..." 
                               HorizontalAlignment="Center" Foreground="{StaticResource TextColor}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Левая панель: Список серверов и конфигурация -->
        <GroupBox Grid.Column="0" Header="Конфигурация папок" Style="{StaticResource ModernGroupBox}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView x:Name="FoldersListView" Grid.Row="1" 
          SelectionChanged="FoldersListView_SelectionChanged"
          MouseDoubleClick="FoldersListView_MouseDoubleClick"
          ItemsSource="{Binding SharedFolders}">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Добавить" Click="AddFolder_Click"/>
                            <MenuItem Header="Редактировать" Click="EditFolder_Click"/>
                            <MenuItem Header="Дублировать" Click="DuplicateFolder_Click"/>
                            <MenuItem Header="Удалить" Click="RemoveFolder_Click"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding ServerName}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SharePath}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Добавить" Width="100" Margin="0,0,10,0" Click="AddFolder_Click"/>
                    <Button Content="Удалить" Width="100" Click="RemoveFolder_Click"/>
                </StackPanel>

                <Label Grid.Row="3" Content="Быстрое подключение:" Style="{StaticResource SectionHeader}"/>
                <TextBox x:Name="ServerTextBox" Grid.Row="4" 
                         Text="\\server\share" Margin="0,0,0,5"/>
                <Button Grid.Row="4" Content="Подключить" HorizontalAlignment="Right" 
                        Width="100" Click="Connect_Click" Margin="0,0,0,5"/>
            </Grid>
        </GroupBox>

        <!-- Правая панель: Просмотр файлов -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                      Background="{StaticResource BorderColor}"/>

        <GroupBox Grid.Column="2" Header="Содержимое папки" Style="{StaticResource ModernGroupBox}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TreeView x:Name="FilesTreeView" Grid.Row="0">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button x:Name="DownloadAllButton" Content="Скачать все" Width="120" Margin="0,0,10,0" 
                            Click="DownloadAllFiles_Click"/> 
                    <Button x:Name="CancelDownloadButton" Content="Отмена" Width="120" Margin="0,0,10,0" 
                            Click="CancelDownload_Click" IsEnabled="False"/>
                    <Button Content="Скачать файл" Width="120" Margin="0,0,10,0" Click="DownloadFile_Click"/>
                    <Button Content="Бэкап логов" Width="120" Click="AllDownload_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>